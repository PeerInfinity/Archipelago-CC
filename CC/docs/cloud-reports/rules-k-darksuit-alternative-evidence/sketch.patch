+// ── SKETCH (rules-k-darksuit-alternative, THROWAWAY): the player's BEST-HEADING speed, measured off the same port ─────
+// `Player.as:1525-1553` caps each AXIS at moveSpeed and `Mobile.as:73-84` shortens the VECTOR by f, so a diagonal press
+// runs faster than an axis press; `Bob.as:61-68` normalizes the body's v to its moveSpeed (isotropic).
+export function measurePlayerHeading({ moveSpeed, friction }, keys, { ticks = MEASURE.ticks, warm = MEASURE.warm, step = PP.step } = {}) {
+    let s = { x: 5e4, y: 5e4, vx: 0, vy: 0 };
+    let x0 = 0, y0 = 0;
+    for (let t = 0; t < ticks; t += 1) {
+        if (t === warm) { x0 = s.x; y0 = s.y; }
+        s = { ...s, ...step(s, new Set(keys), { world: { width: 1e5, height: 1e5 }, moveSpeed, friction }) };
+    }
+    return Math.hypot(s.x - x0, s.y - y0) / (ticks - warm);
