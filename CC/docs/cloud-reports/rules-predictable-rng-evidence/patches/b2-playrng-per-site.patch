diff -ruN a/src/PlayRng.as b/src/PlayRng.as
--- a/src/PlayRng.as	1970-01-01 00:00:00.000000000 +0000
+++ b/src/PlayRng.as	2026-11-22 04:53:50.550179059 +0000
@@ -0,0 +1,88 @@
+package
+{
+	/**
+	 * PlayRng — SKETCH (rules-predictable-rng, design (b2)). NOT BUILT, NOT TESTED.
+	 *
+	 * Every GAMEPLAY draw site (the census: FinalBoss's barrage roll, rock aim, grenade roll and death rocks,
+	 * RockFall's hitbox scale, TentacleBeast's whirlpool and tentacle spawns, the chest's seal pick, the grass
+	 * blades) draws from its OWN stream, re-keyed at every room build from
+	 *
+	 *     (worldSeed, level, entry, site)
+	 *
+	 * so a site's n-th draw in a room is a pure function of those four and n. Nothing else on the page can move it:
+	 * not a sound, not a particle, not an Enemy constructed elsewhere, not the rooms walked before. And because the
+	 * generator is plain AS3 arithmetic (FlashPunk's own Park-Miller step, exact in a double: seed * 16807 < 2^53),
+	 * the same numbers come out in Flash, Ruffle, the recompiled wasm and a JS port. `Math.random()` and the
+	 * `swfmodern.Rng` hooks are not involved at all.
+	 *
+	 * `entry`: 0 for every build when `perEntry` is false (every entry of a room replays the same draws, so a player
+	 * can LEARN a room), or the count of builds of this level since boot when true (a death or re-entry draws
+	 * afresh, still predictable from the count). Which one is Robert's decision; the default here is false.
+	 *
+	 * `worldSeed`: written by the host before the first build (a bridge property, or a tape's `rng.world`); 1 when
+	 * nothing writes it, so a vanilla page is predictable too.
+	 */
+	public class PlayRng
+	{
+		public static var worldSeed:uint = 1;
+		public static var perEntry:Boolean = false;
+
+		/** The site names, ONE per gameplay call site. A new site is a new name: never share a stream. */
+		public static const OWL_BARRAGE:String = "owl.barrage";
+		public static const OWL_AIM:String = "owl.aim";
+		public static const OWL_ROCK_SCALE:String = "owl.rockScale";
+		public static const OWL_GRENADE:String = "owl.grenade";
+		public static const OWL_DEATH:String = "owl.death";
+		public static const TB_WHIRLPOOL:String = "tentacle.whirlpool";
+		public static const TB_TENTACLE:String = "tentacle.tentacle";
+		public static const SEAL:String = "chest.seal";
+		public static const GRASS:String = "tile.grass";
+
+		private static var level:int = -1;
+		private static var entry:int = 0;
+		private static var builds:Object = {};
+		private static var states:Object = {};
+
+		/** Called from `Game.begin()`, BEFORE `loadlevel`: every stream restarts for this room. */
+		public static function enterRoom(_level:int):void
+		{
+			var k:String = String(_level);
+			builds[k] = (builds[k] == undefined) ? 0 : int(builds[k]) + 1;
+			level = _level;
+			entry = perEntry ? int(builds[k]) : 0;
+			states = {};
+		}
+
+		/** One draw in [0, 1) from `site`'s stream in the current room. */
+		public static function draw(site:String):Number
+		{
+			var s:Number = states[site];
+			if (isNaN(s)) s = keyOf(site);
+			s = (s * 16807) % 2147483647;
+			states[site] = s;
+			return s / 2147483647;
+		}
+
+		/** The stream's draw count readout for a bot/witness (no draw). */
+		public static function readout():Object
+		{
+			var o:Object = { world: worldSeed, level: level, entry: entry, per_entry: perEntry, states: {} };
+			for (var k:String in states) o.states[k] = states[k];
+			return o;
+		}
+
+		/** FNV-1a over "world|level|entry|site", folded to 1..2147483646 (Park-Miller's orbit). */
+		private static function keyOf(site:String):Number
+		{
+			var str:String = worldSeed + "|" + level + "|" + entry + "|" + site;
+			var h:uint = 2166136261;
+			for (var i:int = 0; i < str.length; i++)
+			{
+				h ^= str.charCodeAt(i);
+				h = uint((h * 16777619) & 0xFFFFFFFF); // ⚠ sketch: Number product loses low bits past 2^53; a real build
+				                                       // splits the multiply (h * 0x193 + ((h * 0x100) << 16)) as int math.
+			}
+			return (h % 2147483646) + 1;
+		}
+	}
+}
