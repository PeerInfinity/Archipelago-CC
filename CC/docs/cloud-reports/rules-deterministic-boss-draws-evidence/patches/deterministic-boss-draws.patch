diff --git a/src/Pattern.as b/src/Pattern.as
new file mode 100644
index 0000000..29d2148
--- /dev/null
+++ b/src/Pattern.as
@@ -0,0 +1,34 @@
+package
+{
+	/**
+	 * Pattern — fixed, seedless stand-ins for the boss rooms' gameplay draws
+	 * (rules-deterministic-boss-draws). L112 (FinalBoss, RockFall) and L57
+	 * (TentacleBeast) were the only rooms whose hits read `Math.random()`;
+	 * they now read a counter through `vdc`, so each fight is the same on
+	 * every entry and in every runtime (Flash, Ruffle, the recompiled wasm,
+	 * the JS model), with nothing to seed.
+	 */
+	public class Pattern
+	{
+		/**
+		 * The radical inverse of n in base b (van der Corput): n's base-b
+		 * digits mirrored about the point, in [0, 1). Successive n fill the
+		 * interval evenly, so a site keeps its range, mean and spread; two
+		 * coprime bases (2, 3) give an even 2-D cover (the Halton points).
+		 * Exact in any IEEE-754 host: one division per digit, no rounding
+		 * that differs between runtimes.
+		 */
+		public static function vdc(n:int, b:int):Number
+		{
+			var r:Number = 0;
+			var f:Number = 1 / b;
+			while (n > 0)
+			{
+				r += (n % b) * f;
+				n = int(n / b);
+				f /= b;
+			}
+			return r;
+		}
+	}
+}
