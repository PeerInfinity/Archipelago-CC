diff -ruN a/frontend/modules/seedlingDemo/jsRuntimeReportAddress.test.js b/frontend/modules/seedlingDemo/jsRuntimeReportAddress.test.js
--- a/frontend/modules/seedlingDemo/jsRuntimeReportAddress.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/modules/seedlingDemo/jsRuntimeReportAddress.test.js	2026-11-22 03:03:13.037190461 +0000
@@ -0,0 +1,20 @@
+// PROPOSED (rules-spinner-alias-guards, out of scope): the JS page reports a tag -1 write at the CALL's address,
+// once per call, as the game's pendingCheck does (Game.as:1906-1907); the table keeps the slot (Main.as:222).
+import { describe, expect, it } from 'vitest';
+import { liveClears, liveReports } from './jsRuntimeCore.js';
+
+const run = (ledgers) => ({ ledger: (name) => ledgers[name] ?? [], scratchClears: [] });
+// The r8-l18-spinner-press rows (rules-spinner-tag-alias evidence js-l18-spinner-press.json).
+const L18 = run({ spinnerWrites: [
+    { t: 2198, level: 18, id: 'spinner@48,96', flag: { level: 17, tag: 29, value: false }, outOfBand: true },
+    { t: 3278, level: 18, id: 'spinner@112,48', flag: { level: 17, tag: 29, value: false }, outOfBand: true },
+], earnedClears: [{ level: 18, tag: 0 }] });
+
+describe('liveReports — the game\'s report addresses', () => {
+    it('two L18 spinner deaths: two reports at {18,-1} (the wasm witness: 1|18|-1|0, 2|18|-1|0), then {18,0}', () => {
+        expect(liveReports(L18).map((r) => `${r.level}|${r.tag}`)).toEqual(['18|-1', '18|-1', '18|0']);
+    });
+    it('the TABLE is unchanged: the slot {17,29} stays a live clear', () => {
+        expect(liveClears(L18)).toEqual([{ level: 18, tag: 0 }, { level: 17, tag: 29 }]);
+    });
+});
