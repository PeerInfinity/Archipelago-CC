+        const key = `oob:${w.id}:${w.t}`;
+        if (oob.has(key)) continue;
+        oob.add(key);
+        out.push({ key, level: w.level, tag: -1, slot: { level: w.flag?.level, tag: w.flag?.tag } });
+    }
+    const slots = new Set((run.ledger('spinnerWrites') ?? []).filter((w) => w.outOfBand)
+        .map((w) => `${w.flag?.level}:${w.flag?.tag}`));
+    for (const c of liveClears(run)) {
+        const k = `${c.level}:${c.tag}`;
+        if (slots.has(k)) continue;   // reported above, at the call's address
+        out.push({ key: k, level: c.level, tag: c.tag, slot: { level: c.level, tag: c.tag } });
+    }
+    return out;
+}
