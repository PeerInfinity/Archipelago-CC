-/** An entity's persistence tag: its class's forced value, else `tag`, else -1. */
+/**
+ * ⛓ rules-spinner-alias-guards (out of scope, PROPOSED for the fidelity arc) — the loader elements whose `Game.as`
+ * `xml.objects[0].<el>` line passes `o.@tag` RAW to an `int` parameter. An ABSENT attribute there is `int("")` = **0**,
+ * an in-band tag, not the -1 sentinel: only `optionalTag` (`bosskey`/`totempart`/`seed`, Game.as:1894-1900) and the
+ * teleporter's `String(o.@tag) == "" ? -1` (Game.as:2387) read absent as -1, and an element whose loader passes no
+ * `@tag` takes its constructor default. Pinned against `Game.as` by its unit test (the set is read, not chosen).
+ */
+export const LOADER_RAW_TAG = Object.freeze(new Set([
+    'adnanchar', 'apitem', 'bosslock', 'bosstotem', 'breakablerock', 'breakablerockghost', 'burnabletree',
+    'buttonroom', 'chest', 'conch', 'darkshield', 'darksuit', 'darktrap', 'fallrock', 'fallrocklarge', 'feather',
+    'finalboss', 'finaldoor', 'fire', 'firewand', 'forestchar', 'ghostspear', 'ghostsword', 'grasslock', 'health',
+    'hermit', 'introchar', 'karlore', 'lavaboss', 'lightbosscontroller', 'lightpole', 'lock', 'magicallock',
+    'magicallockfire', 'moonrock', 'oracle', 'rekcahdam', 'rocklock', 'rope', 'sandtrap', 'sensei', 'shield',
+    'shieldboss', 'shieldlock', 'shieldlocknorm', 'sign', 'spinner', 'sword', 'tentaclebeast', 'torchpickup', 'totem',
+    'wand', 'wandlock', 'watcher', 'witch', 'yeti',
+]));
+
+/**
+ * An entity's persistence tag: its class's forced value, else `tag`, else what the LOADER makes of an absent one
+ * (`int("")` = 0 for a raw `o.@tag`, else -1).
+ */
 export function tagOf(type, attrs) {
     const forced = FORCED_TAG[type];
     if (forced !== undefined) return forced;
-    return attrs?.tag === undefined ? -1 : Number(attrs.tag);
+    if (attrs?.tag === undefined || attrs.tag === '') return LOADER_RAW_TAG.has(type) ? 0 : -1;
+    return Number(attrs.tag);
 }
 
