diff -ruN a/frontend/modules/seedlingDemo/tagOfAbsentTag.test.js b/frontend/modules/seedlingDemo/tagOfAbsentTag.test.js
--- a/frontend/modules/seedlingDemo/tagOfAbsentTag.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/modules/seedlingDemo/tagOfAbsentTag.test.js	2026-11-22 03:04:53.879053572 +0000
@@ -0,0 +1,31 @@
+// PROPOSED (rules-spinner-alias-guards, out of scope; fidelity arc): `tagOf` reads an ABSENT `@tag` the way the
+// game's loader does. `o.@tag` passed raw to an `int` parameter is `int("")` = 0 (Game.as `xml.objects[0].<el>`).
+import { readFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { describe, expect, it } from 'vitest';
+import { FORCED_TAG, LOADER_RAW_TAG, tagOf } from './levelWorld.js';
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..', '..', '..');
+const GAME = readFileSync(join(ROOT, 'vendor/seedling/src/Game.as'), 'utf8');
+/** Every loader's text: its `for each (o in xml.objects[0].<el>)` up to the next one. */
+const loaders = () => {
+    const hits = [...GAME.matchAll(/for each \(o in xml\.objects\[0\]\.(\w+)\)/g)];
+    return hits.map((h, k) => [h[1], GAME.slice(h.index, k + 1 < hits.length ? hits[k + 1].index : h.index + 2000)]);
+};
+
+describe('tagOf — an absent @tag, as the loader reads it', () => {
+    it('LOADER_RAW_TAG is exactly the loaders that pass o.@tag raw (not optionalTag, not the teleporter form)', () => {
+        const raw = loaders().filter(([, body]) => /o\.@tag/.test(body) && !/optionalTag\(o\.@tag\)/.test(body)
+            && !/String\(o\.@tag\)\s*==\s*""/.test(body)).map(([el]) => el);
+        expect([...LOADER_RAW_TAG].sort()).toEqual([...new Set(raw)].sort());
+    });
+    it('absent → 0 on a raw loader (lock, spinner), -1 on optionalTag / teleporter, FORCED_TAG first', () => {
+        expect(tagOf('lock', {})).toBe(0);
+        expect(tagOf('spinner', undefined)).toBe(0);
+        expect(tagOf('bosskey', {})).toBe(-1);
+        expect(tagOf('teleporter', {})).toBe(-1);
+        expect(tagOf('moonrockpile', {})).toBe(FORCED_TAG.moonrockpile);
+        expect(tagOf('spinner', { tag: '-1' })).toBe(-1);
+    });
+});
