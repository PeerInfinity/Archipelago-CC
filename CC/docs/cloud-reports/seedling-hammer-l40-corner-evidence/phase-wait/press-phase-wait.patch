@@ -0,0 +1,99 @@
+/**
+ * hammerPressPhaseWait — SEEDLING HAMMER-PHASE L40-CORNER: `PRESS_PHASE_WAIT` (OFF), a press kill refused at one
+ * arrival phase redone after standing still 1 … period − 1 ticks (`pressPhaseWait.js`).
+ *
+ * The synthetic phases are `r9-solve-18`'s committed staging with `seam.time` moved to each residue of the hammer's
+ * period (`sweep-seedling-l18-residues.mjs`, `fidelityF1c.test.js`'s `shiftTo`), asked with `HAMMER_ESCAPE` OFF, the
+ * switch that today hides every L18 corner (all 45 residues solve with it ON). Measured at the slice's base
+ * (`--no-escape`): residues 4, 14, 44 refuse `HAMMER_SAFETY` and 38, 40, 41 `STRIKE_BOUND_EXHAUSTED`; with the wait ON
+ * all 45 solve, 0 hits, and the 39 that solved OFF solve with the same keys (digest-identical). The rows below hold the
+ * two cheap `HAMMER_SAFETY` residues and one residue that solves OFF; the L40 witnesses are measured in the report.
+ *
+ * ── THE MUTATION LIST (run during development, each row's catcher named) ──
+ *   m1 the wait never stands (w forced 0)         -> the "refuses OFF, plans ON" row red (the redo is the refused kill)
+ *   m2 the hit audit off (a hit redo adopted)       -> not caught here (no L18 redo takes a hit); the L40 sweep's hit
+ *                                                     column is its catcher (report § 4)
+ *   m3 the switch read as ON by default             -> the default row red
+ */
+import { describe, expect, it } from 'vitest';
+
+import { loadTape } from './fixtures/index.js';
+import { atlasLevelSource } from './levelSource.js';
+import { createRunForStaging, stagingFromTape } from './tapeRunner.js';
+import { HAMMER_SAFETY, withHammerEscape } from './solverBot.js';
+import { twoPassSolve } from './twoPassSolve.js';
+import { SPINNER } from './spinner.js';
+import { SOLVER_ENV_NAMES } from './solverEnvChannel.js';
+import {
+    PRESS_PHASE_WAIT, PRESS_PHASE_WAIT_COUNTS, PRESS_PHASE_WAIT_DEFAULT, pressPhaseWaitSentence, pressPhaseWaits,
+    resetPressPhaseWaitCounts, withPressPhaseWait,
+} from './pressPhaseWait.js';
+
+const NAME = 'r9-solve-18';
+const TAPE = loadTape(NAME);
+const STAGING = stagingFromTape(TAPE);
+const PERIOD = SPINNER.hammerPeriod;
+const RESIDUE = ((STAGING.seam.time % PERIOD) + PERIOD) % PERIOD;
+const shiftTo = (r) => ((((r - RESIDUE) % PERIOD) + PERIOD) % PERIOD) - PERIOD;
+const TELEPORTER = { x: 176, y: 112 };
+
+/** `twoPassSolve` exactly as `fidelityF1c.test.js` calls it, at a residue, with `HAMMER_ESCAPE` OFF. */
+async function solveAt(residue) {
+    const seam = { ...STAGING.seam, time: STAGING.seam.time + shiftTo(residue) };
+    const makeRun = (persistence) => createRunForStaging(
+        { ...STAGING, seam, persistence, equips: [] }, atlasLevelSource());
+    const r = await withHammerEscape(false, () => twoPassSolve({
+        makeRun,
+        goals: [{ kind: 'reach-exit', exit: TELEPORTER }],
+        name: NAME,
+        boot: STAGING.boot,
+        persistence: STAGING.persistence.filter((c) => c.at === undefined),
+        gameTick: async () => { throw new Error('no game oracle here'); },
+    }));
+    const run = createRunForStaging({ ...STAGING, seam, persistence: r.persistence, equips: [] }, atlasLevelSource());
+    for (const held of r.out.perTick) run.advance(held);
+    return { r, run, keys: JSON.stringify(r.out.perTick.map((k) => [...k].sort())) };
+}
+
+const refusalOf = async (fn) => {
+    try { await fn(); } catch (e) { return e; }
+    return null;
+};
+
+describe('hammer-phase L40-CORNER — PRESS_PHASE_WAIT (a refused press kill asked again at the next arrival phases)', () => {
+    it('ships OFF, is a solver-env name, and its waits are 1 … period − 1 of the hammer model', () => {
+        expect(PRESS_PHASE_WAIT_DEFAULT).toBe(false);
+        expect(PRESS_PHASE_WAIT.enabled).toBe(false);
+        expect(SOLVER_ENV_NAMES).toContain('SEEDLING_PRESS_PHASE_WAIT');
+        expect(pressPhaseWaits(PERIOD)).toEqual(Array.from({ length: PERIOD - 1 }, (_, i) => i + 1));
+        expect(pressPhaseWaits(1)).toEqual([]);
+        expect(pressPhaseWaits(Number.NaN)).toEqual([]);
+        expect(pressPhaseWaitSentence({ t: 7, lastWait: 44, period: 45, tries: 44, hitRedos: 1, stoppedBy: null }))
+            .toMatch(/PRESS_PHASE_WAIT.*t7.*1\.\.44 of the hammer's 45-tick period.*44 redo\(s\), 1 with a hit/);
+    });
+
+    it('⛓⛓ refuses OFF and plans ON, hitless, at the residues where the kill met the hammer cornered (14, 44)', async () => {
+        for (const residue of [14, 44]) {
+            const off = await refusalOf(() => solveAt(residue));
+            expect(off?.code, `residue ${residue} OFF`).toBe(HAMMER_SAFETY);
+            expect(off.message).toMatch(/There is no step out\./);
+            resetPressPhaseWaitCounts();
+            const on = await withPressPhaseWait(true, () => solveAt(residue));
+            expect(on.run.playerHits, `residue ${residue} ON`).toEqual([]);
+            expect(on.run.transitions.map((x) => x.to_level)).toEqual([TAPE.boot.level + 1]);
+            expect(PRESS_PHASE_WAIT_COUNTS.solved).toBeGreaterThan(0);
+            const row = PRESS_PHASE_WAIT_COUNTS.rows.find((x) => x.verdict === 'solved');
+            expect(row.wait).toBeGreaterThanOrEqual(1);
+            expect(row.wait).toBeLessThan(PERIOD);
+        }
+    }, 300_000);
+
+    it('⛓ a residue that solves OFF is never answered ON: the same keys, no wait asked (the chain residue 12)', async () => {
+        const off = await solveAt(12);
+        resetPressPhaseWaitCounts();
+        const on = await withPressPhaseWait(true, () => solveAt(12));
+        expect(on.keys).toBe(off.keys);
+        expect(PRESS_PHASE_WAIT_COUNTS.asked).toBe(0);
+        expect(on.run.playerHits).toEqual([]);
+    }, 300_000);
+});
