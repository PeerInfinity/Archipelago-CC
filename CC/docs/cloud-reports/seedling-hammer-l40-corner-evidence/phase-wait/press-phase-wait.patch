+/**
+ * ⛓⛓⛓ SEEDLING HAMMER-PHASE L40-CORNER — **A PRESS KILL REFUSED AT ONE ARRIVAL PHASE IS ASKED AGAIN AT THE NEXT ONES**
+ * (`PRESS_PHASE_WAIT`, OFF).
+ *
+ * Measured (`CC/docs/cloud-reports/seedling-hammer-l40-corner.md` § 3): a press kill of a spinner refuses or plans by the
+ * ARRIVAL PHASE alone. The same request, re-stamped to neighbouring arrival clocks (`staging.seam.time`), refuses at
+ * some and plans hitless at the others: the kill met the hammer at a phase from which every key set lands on a body's
+ * 7x7 rect or on the 13 px line (*"There is no step out."*, `HAMMER_SAFETY`), and one or two ticks later it would not
+ * have. The press kill's search has no such option: its key sets are this tick's, its stall (`HAMMER_PHASE_RUNG`) is
+ * an approach-preview's, and a corner that forms after a press LANDS (the knockback is player-coupled) is outside both.
+ *
+ * ⇒ ON (a segment that can rewind): a press kill that refuses with one of `FIGHT_FALLBACK_CODES`, after every fallback
+ * the defaults already run, is rewound to its first tick; the player STANDS STILL for `w` ticks (each tick asked of the
+ * guard's own landing test, `landsClearOfHammers`, and hit-free), the kill's admission is asked again on that run, and
+ * the kill is redone. `w` runs 1 … period − 1, the period read off the hammer model (`SPINNER.hammerPeriod`: a hold of
+ * `period` ticks is phase 0 again). The FIRST redo that kills with NO player hit since the kill's first tick is
+ * adopted; a redo that kills with a hit is undone and the next `w` is asked (⚖ no-hit logic). None ⇒ the original
+ * refusal stands, its words unchanged plus one sentence. ⛔ A kill that does not refuse never reaches the wait, so
+ * every success OFF and ON is byte-identical; OFF nothing here is read.
+ *
+ * Any spinner body qualifies: no level, coordinate or body id is read. It runs where the press kill runs — the solve
+ * WORKER (and node); the page's main thread never reaches it. `SEEDLING_PRESS_PHASE_WAIT=1` turns it on in a node
+ * process or, through `solverEnvChannel`, in the page's worker; `withPressPhaseWait(enabled, fn)` is for a row.
+ */
+export const PRESS_PHASE_WAIT = { enabled: globalThis.process?.env?.SEEDLING_PRESS_PHASE_WAIT === '1' };
+export const PRESS_PHASE_WAIT_DEFAULT = false;
+
+/**
+ * The switch's instrument, read by nothing that decides: `asked` refusals the wait answered; `solved` / `refused` its
+ * outcomes; `tries` redos run; `hitRedos` redos that killed with a hit (undone); `standBlocked` waits cut because
+ * standing still was not clear; `rows` one per answered refusal.
+ */
+export const PRESS_PHASE_WAIT_COUNTS = { asked: 0, solved: 0, refused: 0, tries: 0, hitRedos: 0, standBlocked: 0, rows: [] };
+export function resetPressPhaseWaitCounts() {
+    for (const k of Object.keys(PRESS_PHASE_WAIT_COUNTS)) PRESS_PHASE_WAIT_COUNTS[k] = k === 'rows' ? [] : 0;
+}
+
+/** A measurement hook, read by nothing that decides: `sink({t, w, outcome, ms})` once per wait asked. */
+export const PRESS_PHASE_WAIT_TRACE = { sink: null };
+
+/** Run `fn` with `PRESS_PHASE_WAIT` set to `enabled`, restoring the previous value. */
+export function withPressPhaseWait(enabled, fn) {
+    const was = PRESS_PHASE_WAIT.enabled;
+    PRESS_PHASE_WAIT.enabled = enabled === true;
+    const restore = () => { PRESS_PHASE_WAIT.enabled = was; };
+    try {
+        const out = fn();
+        if (out && typeof out.then === 'function') return out.finally(restore);
+        restore();
+        return out;
+    } catch (e) {
+        restore();
+        throw e;
+    }
+}
+
+/**
+ * The waits to ask, in order: 1 … period − 1 (a wait of `period` is the refused phase again). A period that is not a
+ * positive integer asks nothing.
+ */
+export function pressPhaseWaits(period) {
+    if (!Number.isInteger(period) || period < 2) return [];
+    return Array.from({ length: period - 1 }, (_, i) => i + 1);
+}
+
+/** The sentence a wait that found no kill appends to the refusal that stands. */
+export function pressPhaseWaitSentence(row) {
+    const why = row.stoppedBy ? ` It stopped at w=${row.lastWait}: ${row.stoppedBy}.` : '';
+    return `The phase wait (\`PRESS_PHASE_WAIT\`) rewound to the kill's first tick (t${row.t}) and redid the kill after `
+        + `standing still 1..${row.lastWait} of the hammer's ${row.period}-tick period; no redo killed hitless `
+        + `(${row.tries} redo(s), ${row.hitRedos} with a hit).${why}`;
+}
