@@ -20992,6 +20995,121 @@ function execKillByPress(run, perTick, resolved, ctx) {
     return execKillByPressFightFallback(run, perTick, resolved, ctx);
 }
 
+/** The press kill as the defaults drive it, fallbacks included: `execKillByPress` below its own phase-wait branch. */
+function execKillByPressDefault(run, perTick, resolved, ctx) {
+    if (OPP_PRESS_FALLBACK.enabled && OPPORTUNISTIC_STRIKE.enabled && ctx.rewind) {
+        return execKillByPressOppFallback(run, perTick, resolved, ctx);
+    }
+    return execKillByPressFightFallback(run, perTick, resolved, ctx);
+}
+
+/**
+ * ⛓⛓ hammer-phase L40-CORNER — `PRESS_PHASE_WAIT` (see `pressPhaseWait.js`). The kill runs as the defaults drive it;
+ * only a refusal with a `FIGHT_FALLBACK_CODES` code is answered. For each wait `w` (1 … the hammer period − 1) the
+ * segment is rewound to the kill's first tick, the player stands still `w` ticks (every tick clear by the guard's own
+ * `landsClearOfHammers`, and hit-free), the order's admission is asked again on that run (as the fallbacks ask it),
+ * and the kill is redone. The first redo that kills with no player hit since the kill's first clock is adopted. A
+ * stand that is not clear at tick `i` cuts every longer wait (the stand only gets longer). A tripped deadline stops it.
+ * None ⇒ undone, and the original refusal is thrown plus one sentence.
+ */
+function execKillByPressPhaseWait(run, perTick, resolved, ctx) {
+    const t0 = perTick.length;
+    try {
+        return execKillByPressDefault(run, perTick, resolved, ctx);
+    } catch (e) {
+        if (!(e instanceof SolverBotError) || !FIGHT_FALLBACK_CODES.includes(e.code) || e.pressPhaseWait) throw e;
+        if (activeDeadline !== null && activeDeadline.tripped.size > 0) throw e;
+        PRESS_PHASE_WAIT_COUNTS.asked += 1;
+        const NO_KEYS = new Set();
+        const admission = PRESS_ADMISSIONS.get(resolved.plans) ?? null;
+        const row = { t: t0, refused: e.code, period: SPINNER.hammerPeriod, bodies: resolved.plans.map((p) => p.id),
+            tries: 0, hitRedos: 0, lastWait: 0, stoppedBy: null };
+        for (const w of pressPhaseWaits(SPINNER.hammerPeriod)) {
+            if (activeDeadline !== null && activeDeadline.tripped.size > 0) {
+                row.stoppedBy = 'the caller\'s deadline tripped';
+                break;
+            }
+            row.lastWait = w;
+            const tw = PRESS_PHASE_WAIT_TRACE.sink ? performance.now() : 0;
+            const told = (outcome) => PRESS_PHASE_WAIT_TRACE.sink?.({ t: t0, w, outcome, ms: performance.now() - tw });
+            const { run: fresh, undo } = ctx.rewind.to(t0);
+            const clock0 = fresh.ticksCompleted;
+            let stand = null;
+            for (let i = 0; i < w && stand === null; i += 1) {
+                if (!landsClearOfHammers(fresh, NO_KEYS)) {
+                    stand = `standing still is not clear of the hammers at wait tick ${i + 1}`;
+                    break;
+                }
+                perTick.push(NO_KEYS);
+                const { transition } = fresh.advance(NO_KEYS);
+                if (transition) stand = `the run crossed to level ${transition.to_level} while standing still`;
+                else if (playerHitsSince(fresh, clock0).length > 0) stand = `the player was hit standing still at wait tick ${i + 1}`;
+            }
+            if (stand !== null) {
+                undo();
+                told('stand-blocked');
+                PRESS_PHASE_WAIT_COUNTS.standBlocked += 1;
+                row.stoppedBy = stand;
+                break;
+            }
+            row.tries += 1;
+            PRESS_PHASE_WAIT_COUNTS.tries += 1;
+            try {
+                const press = admission === null ? null : derivePressKill(fresh, admission.bodies, admission.contacts);
+                const again = press?.first ? { ...resolved, first: press.first, plans: press.plans } : resolved;
+                const record = execKillByPressDefault(fresh, perTick, again, ctx);
+                const hits = playerHitsSince(ctx.rewind.replay(perTick.length), clock0);
+                if (hits.length > 0) {
+                    undo();
+                    told('hit');
+                    row.hitRedos += 1;
+                    PRESS_PHASE_WAIT_COUNTS.hitRedos += 1;
+                    continue;
+                }
+                row.verdict = 'solved';
+                row.wait = w;
+                row.ticks = perTick.length - t0;
+                told('killed');
+                PRESS_PHASE_WAIT_COUNTS.solved += 1;
+                PRESS_PHASE_WAIT_COUNTS.rows.push({ ...row });
+                ctx.rewind.note({ ...row, how: 'phase-wait' });
+                return { ...record, pressPhaseWait: row };
+            } catch (e2) {
+                // ⛓ the kill completed and its lock tail raised the declaration: adopted when hitless, the throw goes on
+                if (e2 instanceof PendingDeclaration || e2?.undeclaredKillLock) {
+                    const hits = playerHitsSince(ctx.rewind.replay(perTick.length), clock0);
+                    if (hits.length === 0) {
+                        row.verdict = 'solved';
+                        row.wait = w;
+                        row.ticks = perTick.length - t0;
+                        row.raised = e2?.undeclaredKillLock ? 'undeclaredKillLock' : e2.name;
+                        PRESS_PHASE_WAIT_COUNTS.solved += 1;
+                        PRESS_PHASE_WAIT_COUNTS.rows.push({ ...row });
+                        ctx.rewind.note({ ...row, how: 'phase-wait' });
+                        throw e2;
+                    }
+                    row.hitRedos += 1;
+                    PRESS_PHASE_WAIT_COUNTS.hitRedos += 1;
+                    undo();
+                    continue;
+                }
+                undo();
+                told(`refused:${e2?.code ?? e2?.name ?? 'Error'}`);
+                // ⛔ only the solver's own refusals are a phase's verdict; anything else is a defect and goes on
+                if (!(e2 instanceof SolverBotError) && !(e2 instanceof SolverRefusal)) throw e2;
+            }
+        }
+        row.verdict = 'refused';
+        PRESS_PHASE_WAIT_COUNTS.refused += 1;
+        PRESS_PHASE_WAIT_COUNTS.rows.push({ ...row });
+        const out = new SolverBotError(`${e.message} ${pressPhaseWaitSentence(row)}`,
+            { code: e.code, boundTicks: e.boundTicks });
+        for (const k of ['fightFallback', 'oppPressFallback']) if (e[k]) out[k] = e[k];
+        out.pressPhaseWait = row;
+        throw out;
+    }
+}
