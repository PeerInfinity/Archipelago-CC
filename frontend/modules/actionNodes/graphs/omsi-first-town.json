      "omsi": {"type": "game", "name": "Idle Loops (omsi-loops)", "repo": "PeerInfinity/omsi-loops", "commit": "a636e9a410", "files": ["data/actionList.xml", "actionList.js"], "note": "action names, town-0 structure and the numbers the rules below scale"},
      "an-omsi-d": {"type": "model", "model": "claude-opus-5-5", "date": "2026-11-24", "session": "an-omsi-design", "note": "omsi-loops town 0 (Beginnersville) mapped to 20 nodes by the AN-OMSI-D design: time = ceil(omsi level-0 mana / 20) with a 100-mana loop; each item +10 starting mana; multipart actions are one performance per segment; a stated limit is kept, a growing limit flattened (Smash Pots 3, Pick Locks 2, Short Quest 2, Long Quest 2), an unstated one capped at 3 (Haggle 2), progress actions 1; gold / 10; every-Nth rewards given every time. The first step of each progress bar (Wander, Met, Secrets) is `after` (done this loop); later steps are boost items. Combat + Magic >= 35 is Combat 2 and Magic 2: a Training item gives +1 every loop, a Lesson +1 within the loop. Every action except the start and the goal is a check (18), with 10 Soulstones as filler. Trained stats (Str, Dex, ...), talents, skill exp and story texts are not modelled.", "approved": {"by": "Robert", "date": "2026-11-24", "ruling": "Q1-Q6 as recommended (the town numbers; commit the preset)"}},
      "left-out": {"type": "model", "model": "claude-opus-5-5", "date": "2026-11-24", "session": "an-omsi-design", "note": "LEFT OUT of town 0 (six omsi actions): Open Rift (Dark and Spatiomancy, later-town skills); AssassinZ0 (Assassin, a town-7 skill); SurveyZ0, Hitch Ride and Map (explore progress, whose first map comes from town 7's Explorers Guild); Found Glasses (never startable, a display row). Also dropped: the glasses' Wander x4 (Wander progress is a boost here), Throw Party's Met +3200 (nothing after the party reads Met), Small Dungeon's soulstones and the multiparts' skill exp, and the segments' rising cost curve."},
      "buy-supplies-6": {"type": "model", "model": "claude-opus-5-5", "date": "2026-11-24", "session": "an-omsi-design", "note": "Buy Supplies costs 6 gold, not omsi's 300 / 10 = 30: one loop holds at most 12 gold with every item, and the goal is refused at 10", "approved": {"by": "Robert", "date": "2026-11-24", "ruling": "Q5: 6 gold"}},
      "haggle-folded": {"type": "model", "model": "claude-opus-5-5", "date": "2026-11-24", "session": "an-omsi-design", "note": "Haggle's -20 gold on Buy Supplies' price is folded into Gold +2 per Haggle (the same for the one purchase a loop makes)"}
    },
