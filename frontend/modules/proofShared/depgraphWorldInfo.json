{
  "_comment": "DepGraph apworld metadata the AP server does not send. depgraphRulesBuilder.js copies it into a rules.json built from server data. depgraphRulesBuilder.test.js holds it equal to every committed DepGraph preset, so refresh it from a regenerated preset when the apworld's options or web info change.",
  "game_directory": "depgraph",
  "world_class_name": "DepGraphWorld",
  "world_directory": "depgraph",
  "world_description": "Turn any directed acyclic graph into an Archipelago world!\nEach node is both a location (unlocking it) and an item (ability to use it).\nNavigate dependency edges across the multiworld to reach the final node.",
  "web": {
    "theme": "grass",
    "tutorials": [
      {
        "name": "Multiworld Setup Guide",
        "description": "A guide to setting up DepGraph for MultiWorld.",
        "language": "English",
        "file_name": "setup_en.md",
        "link": "setup/en",
        "authors": [
          "Archipelago Team"
        ]
      }
    ]
  },
  "option_definitions": {
    "accessibility": {
      "type": "choice",
      "name_lookup": {
        "0": "full",
        "2": "minimal"
      },
      "default": 0,
      "display_name": "Accessibility"
    },
    "entrance_rule_mode": {
      "type": "choice",
      "name_lookup": {
        "0": "strict",
        "1": "relaxed_items",
        "2": "relaxed_events",
        "3": "fully_relaxed"
      },
      "default": 1,
      "display_name": "Entrance Rule Mode"
    },
    "graph_file": {
      "type": "choice",
      "name_lookup": {
        "0": "tech_tree",
        "1": "skill_tree",
        "2": "recipe_chain",
        "3": "baking_adventure",
        "4": "coding_adventure",
        "5": "swfrecomp_vibe_coding",
        "6": "taskflow_example"
      },
      "default": 4,
      "display_name": "Graph File"
    },
    "progression_balancing": {
      "type": "range",
      "range_start": 0,
      "range_end": 99,
      "default": 50,
      "display_name": "Progression Balancing"
    },
    "randomize_items": {
      "type": "toggle",
      "default": true,
      "display_name": "Randomize Items"
    },
    "randomize_starting_nodes": {
      "type": "toggle",
      "default": true,
      "display_name": "Randomize Starting Nodes"
    },
    "starting_nodes": {
      "type": "range",
      "range_start": 0,
      "range_end": 50,
      "default": 0,
      "display_name": "Starting Nodes %"
    },
    "vanilla_placement": {
      "type": "toggle",
      "default": false,
      "display_name": "Vanilla Item Placement"
    }
  },
  "default_options": {
    "accessibility": 0,
    "entrance_rule_mode": 1,
    "exclude_locations": [],
    "graph_file": 4,
    "item_links": [],
    "local_items": [],
    "non_local_items": [],
    "plando_items": [],
    "priority_locations": [],
    "progression_balancing": 50,
    "randomize_items": true,
    "randomize_starting_nodes": true,
    "start_hints": [],
    "start_inventory": {},
    "start_location_hints": [],
    "starting_nodes": 0,
    "vanilla_placement": false
  }
}
