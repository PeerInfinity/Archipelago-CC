{
  "_comment": "MetaMath apworld metadata the AP server does not send. metamathRulesBuilder.js copies it into a rules.json built from server data. metamathRulesBuilder.test.js holds it equal to every committed MetaMath preset, so refresh it from a regenerated preset when the apworld's options or web info change.",
  "game_directory": "metamath",
  "world_class_name": "MetamathWorld",
  "world_directory": "metamath",
  "world_description": "Turn MetaMath proofs into Archipelago worlds!\nEach proof step is both a location (proving it) and an item (ability to use it).\nNavigate logical dependencies across the multiworld to complete your proof.",
  "web": {
    "theme": "grass",
    "tutorials": [
      {
        "name": "Multiworld Setup Guide",
        "description": "A guide to setting up Metamath for MultiWorld.",
        "language": "English",
        "file_name": "setup_en.md",
        "link": "setup/en",
        "authors": [
          "Archipelago Team"
        ]
      }
    ]
  },
  "option_definitions": {
    "accessibility": {
      "type": "choice",
      "name_lookup": {
        "0": "full",
        "2": "minimal"
      },
      "default": 0,
      "display_name": "Accessibility"
    },
    "auto_download_database": {
      "type": "toggle",
