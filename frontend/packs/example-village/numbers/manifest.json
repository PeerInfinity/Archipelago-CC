{
  "schema_version": 1,
  "provenance": {
    "sources": {
      "actionnodes-design": {
        "type": "model",
        "model": "claude-fable-5-2",
        "date": "2026-11-15",
        "session": "actionnodes-design",
        "approved": { "by": "Robert", "date": "2026-11-15", "ruling": "A14: accepted for initial testing, details adjustable" }
      },
      "do-chores-change": {
        "type": "model",
        "model": "claude-fable-5-2",
        "date": "2026-11-15",
        "session": "actionnodes-design",
        "note": "Do Chores made repeatable (5 mana, Gold +3, limit 2); the floated 'three times, +5 each' makes the goal impossible"
      },
      "an1-boost-mana": {
        "type": "model",
        "model": "claude-opus-5-5",
        "date": "2026-11-15",
        "session": "actionnodes-an1",
        "note": "The boon's name and stat/gold amounts are actionnodes-design's; AN-1 set `gives.mana: 0` explicitly. Under the ruled default (+10 starting mana per item) the goal no longer needs the bread, which is the accepted example's puzzle"
      }
    },
    "default": "actionnodes-design",
    "groups": {
      "action_nodes/example-village:task/do-chores": "do-chores-change",
      "action_nodes/example-village:boon/": "an1-boost-mana"
    }
  },
  "sets": {
    "action_nodes": {
      "exists": "example-village",
      "economy": { "loop_mana": 100, "settings": { "xpGainScale": 1, "xpEffect": "cost" } },
      "values": {
        "example-village:boon/strength-boost": { "count": 1, "results.example-village:stat/strength": 1, "results.example-village:resource/mana": 0 },
        "example-village:boon/pocket-money": { "count": 1, "results.example-village:resource/gold": 5, "results.example-village:resource/mana": 0 },
        "example-village:task/start": { "time": 0, "limit": 1 },
        "example-village:task/do-chores": { "time": 5, "limit": 2, "results.example-village:resource/gold": 3 },
        "example-village:task/train": { "time": 20, "limit": 1, "results.example-village:stat/strength": 1 },
        "example-village:task/read-the-notice": { "time": 10, "limit": 1, "results.example-village:stat/knowledge": 1 },
        "example-village:task/eat-bread": { "time": 0, "limit": 1, "requires.example-village:resource/bread.min": 1, "results.example-village:resource/mana": 30 },
        "example-village:task/buy-bread": { "time": 5, "limit": 1, "requires.example-village:resource/gold.min": 5, "results.example-village:resource/bread": 1 },
        "example-village:task/bribe-the-guard": { "time": 5, "limit": 1, "requires.example-village:resource/gold.min": 5 },
        "example-village:task/guards-locker": { "time": 30, "limit": 1 },
        "example-village:task/move-the-boulder": { "time": 40, "limit": 1, "requires.example-village:stat/strength.min": 1 },
        "example-village:task/leave-the-village": { "time": 40, "limit": 1, "requires.example-village:stat/strength.min": 2, "requires.example-village:stat/knowledge.min": 1 }
      }
    }
  }
}
