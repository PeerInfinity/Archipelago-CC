{
  "activeLayout": "textadventure",
  "moduleSettings": {
    "regionGraph": {
      "clickActions": {
        "enabled": true,
        "region": {
          "path.route": {
            "from": "pathEnd"
          },
          "path.checkAll": false,
          "regions.open": false
        },
        "location": {
          "path.check": "now"
        }
      }
    },
    "discovery": {
      "enableDiscoveryMode": true,
      "regionDiscoveryTrigger": "onEnter",
      "autoDiscoverLocations": true,
      "autoDiscoverExits": true,
      "undiscoveredDisplay": "placeholder",
      "clickDiscoversRegion": true,
      "disableLocationCheckUI": true,
      "clickDiscoversLocation": true,
      "showUndiscoveredRegionNames": true
    }
  }
}
