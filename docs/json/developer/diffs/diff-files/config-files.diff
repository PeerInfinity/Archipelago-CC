+            echo "run: $EVENT on $REF always runs"; echo true; return
+          fi
+          # A new branch has no `before`: compare against main's merge-base.
+          base="$BEFORE"
+          case "$base" in ''|0000000000000000000000000000000000000000) base=main ;; esac
+          if ! files=$(gh api "repos/$REPO/compare/$base...$SHA" --jq '.files[].filename'); then
+            echo "run: could not list the changes ($base...$SHA)" >&2; echo true; return
+          fi
+          n=$(printf '%s\n' "$files" | grep -c . || true)
+          # The compare API lists at most 300 files: a longer list is truncated.
+          if [ "$n" -ge 300 ]; then echo "run: $n changed files (list may be truncated)" >&2; echo true; return; fi
